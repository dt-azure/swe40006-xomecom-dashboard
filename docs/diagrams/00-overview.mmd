---
title: Xóm E-Com · Data flow overview
---
%% Mirrors the PNG/SVG of the same name. Render 16:9:
%%   npx -y @mermaid-js/mermaid-cli -i <file>.mmd -o <file>-mermaid.png -w 1920 -H 1080 -b white -s 2
flowchart LR
    SRC[("① xom_source<br/>source database<br/>orders, customers, products, regions")]
    POLL["② Source poller<br/>sends new and changed rows<br/>every 5 s"]
    API["③ Raw data API<br/>Flask<br/>checks and publishes records"]
    KAFKA{{"④ Kafka<br/>raw.ecom_records<br/>3 partitions"}}
    CONS["⑤ Bronze consumer<br/>micro-batches into bronze"]
    subgraph WH["⑥ WAREHOUSE · Postgres xom"]
        direction LR
        BRONZE[("bronze<br/>raw records, append-only")]
        SILVER[("silver<br/>cleaned, latest version")]
        GOLD[("gold<br/>star schema + 4 marts")]
        BRONZE --> SILVER --> GOLD
    end
    TR["⑦ Transform runner + dbt<br/>every 30 s, when bronze has new rows<br/>82 data tests"]
    DASH["⑧ CommercePulse<br/>Streamlit dashboard<br/>5 pages"]
    USERS(["Business users"])

    SRC -- "rows" --> POLL -- "POST" --> API -- "publish" --> KAFKA -- "poll" --> CONS -- "insert" --> BRONZE
    BRONZE -- "new rows?" --> TR
    TR -- "builds" --> SILVER
    TR -- "builds" --> GOLD
    GOLD -- "SQL" --> DASH --> USERS

    classDef proc fill:#fff8eb,stroke:#d48806,color:#1f2937
    classDef store fill:#eaf2ff,stroke:#2f6fde,color:#1f2937
    classDef stream fill:#e7f7ee,stroke:#15965a,color:#1f2937
    classDef serve fill:#fdecef,stroke:#c23a57,color:#1f2937
    classDef bronze fill:#f7e8da,stroke:#b4692b,color:#1f2937
    classDef silver fill:#eef1f5,stroke:#7b8797,color:#1f2937
    classDef gold fill:#fbf1cc,stroke:#c29408,color:#1f2937
    classDef decision fill:#f3efff,stroke:#7c5cd6,color:#1f2937
    classDef ctx fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:6 4,color:#1f2937
    classDef ok fill:#eaf8f0,stroke:#15965a,color:#1f2937
    classDef fail fill:#fdeeee,stroke:#c2413b,color:#1f2937
    class POLL,API,CONS,TR proc
    class SRC store
    class KAFKA stream
    class DASH,USERS serve
    class BRONZE bronze
    class SILVER silver
    class GOLD gold
    style WH fill:#f5f8fe,stroke:#cddbf3
