# Local Postgres started by docker compose. Host port 5434 stays clear of native Postgres
# installs, which take 5432 (Homebrew) and 5433 (EnterpriseDB installer).
POSTGRES_USER=xom
POSTGRES_PASSWORD=xom
POSTGRES_DB=xom
POSTGRES_PORT=5434

# How processes on the host (loader, flask run, pytest) reach that Postgres.
DATABASE_URL=postgresql://xom:xom@localhost:5434/xom

# The simulated source system, xom_source: a separate database on the same Postgres server.
# Created and loaded by `python -m src.source.seed`.
SOURCE_DATABASE_URL=postgresql://xom:xom@localhost:5434/xom_source

# CI database: a throwaway copy that scripts/seed_ci_bronze.py fills with fixture bronze rows.
# Its name must end in _ci.
CI_DATABASE_URL=postgresql://xom:xom@localhost:5434/xom_ci

# dbt (run from dbt/). dbt does not read this file: export it first with
#   set -a; source ../.env; set +a
DBT_TARGET=dev
DBT_PG_HOST=localhost
DBT_PG_PORT=5434
DBT_PG_USER=xom
DBT_PG_PASSWORD=xom
DBT_PG_DBNAME=xom
DBT_CI_DBNAME=xom_ci

# Transform runner: seconds between cycles. It builds DATABASE_URL's database and sets the
# DBT_PG_* values from it.
TRANSFORM_INTERVAL_SECONDS=30

# Raw data API. 5001 because macOS AirPlay Receiver usually holds 5000.
API_PORT=5001
APP_VERSION=dev

# Kafka: one broker, reachable from the host on 127.0.0.1 only. Inside compose the services use
# kafka:19092 (set in docker-compose.yml).
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=raw.ecom_records

# Bronze consumer: a batch is flushed at this many messages or after this many seconds.
CONSUMER_BATCH_SIZE=1000
CONSUMER_FLUSH_SECONDS=2

# Source poller: where it posts (the API on the host; compose uses http://api:5000), how often it
# looks for new xom_source rows, and how many rows per POST.
API_URL=http://localhost:5001
POLLER_INTERVAL_SECONDS=5
POLLER_BATCH_SIZE=1000

# Source SQL Server; used only by src/extract.
MSSQL_SERVER=db.xomdata.com,1433
MSSQL_DATABASE=xomdata_dataset
MSSQL_USER=change-me
MSSQL_PASSWORD=change-me



