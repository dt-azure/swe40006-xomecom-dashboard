# /opt/xom/.env on each server. Lives ONLY on the server: never commit the real file.
#   chmod 600 /opt/xom/.env
#
# xom-test uses the *_test_* users and databases; xom-prod uses the *_prod_* ones.
# deploy.sh checks this before every deploy: on production, APP_ENV must be "production"
# and every user and database name must contain "_prod" (on test: "test" and "_test").
# When copying this file between servers, change the users, the databases AND the passwords.
# Passwords: generated with `openssl rand -hex 16` (hex only: a `$` would be read as a variable).

APP_ENV=test        # test | production

# Pipeline (read-write): warehouse and source databases, owned by xom_test_app
DATABASE_URL=postgresql://xom_test_app:<TEST_APP_PW>@xom-db.cf4akwek0st3.ap-southeast-2.rds.amazonaws.com:5432/xom_test?sslmode=require
SOURCE_DATABASE_URL=postgresql://xom_test_app:<TEST_APP_PW>@xom-db.cf4akwek0st3.ap-southeast-2.rds.amazonaws.com:5432/xom_test_source?sslmode=require

# Dashboard (read-only on schema gold)
DASHBOARD_DATABASE_URL=postgresql://xom_test_reader:<TEST_READER_PW>@xom-db.cf4akwek0st3.ap-southeast-2.rds.amazonaws.com:5432/xom_test?sslmode=require

# dbt has no sslmode in its profile, so libpq takes it from here
PGSSLMODE=require

# Optional tuning (defaults shown)
# KAFKA_HEAP_OPTS=-Xmx384m -Xms384m
# DASHBOARD_PORT=80
# TRANSFORM_INTERVAL_SECONDS=30
# POLLER_INTERVAL_SECONDS=5
