# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. On the EC2 servers the real values live in a file on
# the server only, never in the repository or the image.
#
# These names are the contract between workstreams. If you need a new
# variable, add it here in the same pull request that starts using it.

# Which environment this is: local | test | production
APP_ENV=local

# --- Source API (Flask over SQLite) ----------------------------------------
SOURCE_API_PORT=5000
SQLITE_PATH=data/source.db

# --- Pipeline ---------------------------------------------------------------
# Where the pipeline fetches from
SOURCE_API_URL=http://localhost:5000
# Page size used when calling /api/v1/orders
SOURCE_API_PAGE_SIZE=500

# --- PostgreSQL (local container now, RDS later) ---------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-only

# --- Dashboard (Streamlit) --------------------------------------------------
DASHBOARD_PORT=8501
