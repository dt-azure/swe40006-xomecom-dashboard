===== 09-values-prod | Sequence, poller offsets and gold totals: local vs RDS test vs RDS prod
===== started 2026-11-19T14:34:46+00:00 | exit 0
$ Q1="select sequencename, last_value from pg_sequences where schemaname = 'e_commerce';"
Q2="select entity, last_change_seq from ops.source_offsets order by entity;"
Q3="select count(*) as lines, sum(sales) as sales, sum(net_sales) as net_sales, sum(profit) as profit from gold.fct_sales_lines;"
echo "== change_seq sequence"; echo -n "local: "; docker compose -p xom-ecom exec -T postgres psql -U xom -d xom_source -At -c "$Q1"; echo -n "test:  "; psql -U xom_test_app -d xom_test_source -At -c "$Q1"; echo -n "prod:  "; psql -U xom_prod_app -d xom_prod_source -At -c "$Q1"
echo "== ops.source_offsets"; echo "local: $(docker compose -p xom-ecom exec -T postgres psql -U xom -d xom -At -c "$Q2" | tr "\n" " ")"; echo "test:  $(psql -U xom_test_app -d xom_test -At -c "$Q2" | tr "\n" " ")"; echo "prod:  $(psql -U xom_prod_app -d xom_prod -At -c "$Q2" | tr "\n" " ")"
echo "== gold.fct_sales_lines (lines | sales | net_sales | profit)"; echo -n "local: "; docker compose -p xom-ecom exec -T postgres psql -U xom -d xom -At -c "$Q3"; echo -n "test:  "; psql -U xom_test_app -d xom_test -At -c "$Q3"; echo -n "prod:  "; psql -U xom_prod_app -d xom_prod -At -c "$Q3"
