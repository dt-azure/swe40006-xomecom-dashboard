---
title: 02 · Source poller
---
%% Mirrors the PNG/SVG of the same name. Render 16:9:
%%   npx -y @mermaid-js/mermaid-cli -i <file>.mmd -o <file>-mermaid.png -w 1920 -H 1080 -b white -s 2
flowchart LR
    SRC[("xom_source<br/>4 tables")]
    OFF[("ops.source_offsets<br/>mark per table")]
    API["Raw data API<br/>see 03"]
    TICK(["Every 5 s"]) --> NEXT["Next table<br/>customer, product,<br/>region, sales_line"]
    NEXT --> READ["Read next batch<br/>change_seq > mark<br/>up to 1,000 rows"]
    READ --> ROWS{"Rows<br/>left?"}
    ROWS -- "no: next table<br/>(after sales_line, wait for the next tick)" --> NEXT
    ROWS -- "yes" --> WRAP["Wrap each row<br/>in the record envelope"]
    WRAP --> POST["POST the batch<br/>/api/v1/records"]
    POST <-- "batch / reply" --> API
    POST --> OK{"202?"}
    OK -- "yes" --> SAVE["Save the mark<br/>last change_seq of the batch"]
    OK -- "no" --> STOP["Stop the cycle<br/>mark unchanged, retry next tick"]
    SAVE -- "repeat until the table is drained" --> READ
    SRC -- "rows" --> READ
    OFF -. "mark to start from" .-> READ
    SAVE -- "save" --> OFF

    classDef proc fill:#fff8eb,stroke:#d48806,color:#1f2937
    classDef store fill:#eaf2ff,stroke:#2f6fde,color:#1f2937
    classDef stream fill:#e7f7ee,stroke:#15965a,color:#1f2937
    classDef serve fill:#fdecef,stroke:#c23a57,color:#1f2937
    classDef bronze fill:#f7e8da,stroke:#b4692b,color:#1f2937
    classDef silver fill:#eef1f5,stroke:#7b8797,color:#1f2937
    classDef gold fill:#fbf1cc,stroke:#c29408,color:#1f2937
    classDef decision fill:#f3efff,stroke:#7c5cd6,color:#1f2937
    classDef ctx fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:6 4,color:#1f2937
    classDef ok fill:#eaf8f0,stroke:#15965a,color:#1f2937
    classDef fail fill:#fdeeee,stroke:#c2413b,color:#1f2937
    class TICK,API ctx
    class NEXT,READ,WRAP,POST,SAVE proc
    class ROWS,OK decision
    class SRC,OFF store
    class STOP fail
    linkStyle 9 stroke:#c2413b
