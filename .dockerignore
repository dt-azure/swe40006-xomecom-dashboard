.github
.env
.env.*
!.env.example
*.pem
*.key

data
data_pipeline
dashboard_server
references
tests
*.db
*.sqlite
*.sqlite3
*.csv
*.zip

__pycache__
*.py[cod]
.venv
venv
.pytest_cache
.ruff_cache
.coverage
htmlcov

docs
*.md
.vscode
.idea
.DS_Store
