# Copy to .env for local development:  cp .env.example .env

# Which environment this is: local | test | production
APP_ENV=local

# --- Source API (Flask over SQLite) ----------------------------------------
SOURCE_API_PORT=5000
SQLITE_PATH=data/source.db

# --- Pipeline ---------------------------------------------------------------
# Where the pipeline fetches from
SOURCE_API_URL=http://localhost:5000
# Page size used when calling /api/v1/orders
SOURCE_API_PAGE_SIZE=500

# --- PostgreSQL (local container now, RDS later) ---------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-local-only

# The dashboard reads gold from the data pipeline's local warehouse (database xom, host port 5434).
# host.docker.internal reaches the host from inside the dashboard container.
DASHBOARD_DATABASE_URL=postgresql://xom:xom@host.docker.internal:5434/xom

# --- Dashboard (Streamlit) --------------------------------------------------
DASHBOARD_PORT=8501

# Host port for the local PostgreSQL (5434 stays clear of a native install on 5432)
LOCAL_PG_PORT=5434

# Running the dashboard outside Docker (python -m streamlit run dashboard/app.py) against the
# local stack's database:
DASHBOARD_DATABASE_URL=postgresql://xom:xom@localhost:5434/xom
