===== 08-row-counts-prod | Row counts per table: local vs RDS test vs RDS prod
===== started 2026-11-19T14:34:36+00:00 | exit 0
$ docker compose -p xom-ecom exec -T postgres psql -U xom -d xom        -At -F " " < ~/xom-dumps/counts.sql > /tmp/p_local_xom.txt
docker compose -p xom-ecom exec -T postgres psql -U xom -d xom_source -At -F " " < ~/xom-dumps/counts.sql > /tmp/p_local_src.txt
psql -U xom_test_app -d xom_test        -At -F " " < ~/xom-dumps/counts.sql > /tmp/p_test_xom.txt
psql -U xom_test_app -d xom_test_source -At -F " " < ~/xom-dumps/counts.sql > /tmp/p_test_src.txt
psql -U xom_prod_app -d xom_prod        -At -F " " < ~/xom-dumps/counts.sql > /tmp/p_prod_xom.txt
psql -U xom_prod_app -d xom_prod_source -At -F " " < ~/xom-dumps/counts.sql > /tmp/p_prod_src.txt
cat /tmp/p_local_src.txt /tmp/p_local_xom.txt > /tmp/p_l.txt; cat /tmp/p_test_src.txt /tmp/p_test_xom.txt > /tmp/p_t.txt; cat /tmp/p_prod_src.txt /tmp/p_prod_xom.txt > /tmp/p_p.txt
join /tmp/p_l.txt /tmp/p_t.txt | join - /tmp/p_p.txt | awk "BEGIN{printf \"%-34s %9s %9s %9s  %s\n\", \"table\", \"local\", \"rds_test\", \"rds_prod\", \"match\"} {printf \"%-34s %9s %9s %9s  %s\n\", \$1, \$2, \$3, \$4, (\$2==\$3 && \$2==\$4?\"OK\":\"MISMATCH\")}"
echo; diff /tmp/p_l.txt /tmp/p_p.txt && diff /tmp/p_t.txt /tmp/p_p.txt && echo "All $(wc -l < /tmp/p_p.txt | tr -d " ") tables match"
