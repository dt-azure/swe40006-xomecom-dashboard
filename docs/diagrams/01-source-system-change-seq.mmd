%% Mirrors the PNG/SVG of the same name. Render 16:9:
%%   npx -y @mermaid-js/mermaid-cli -i <file>.mmd -o <file>-mermaid.png -w 1920 -H 1080 -b white -s 2
flowchart LR
    INS(["INSERT a row"]) --> NEXT["change_seq = nextval()<br/>sequence e_commerce.change_seq"]
    UPD(["UPDATE a row"]) --> TRIG["Trigger bump_change_seq<br/>sets a new, higher change_seq"]
    NEXT --> VER["Every row version<br/>has a unique change_seq,<br/>higher than all before it"]
    TRIG --> VER
    VER -- "indexed" --> READ["Poller reads the next batch<br/>WHERE change_seq > mark<br/>ORDER BY change_seq LIMIT 1000"]
    READ --> POLL["Source poller<br/>see 02"]

