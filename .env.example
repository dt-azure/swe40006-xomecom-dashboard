# Optional local settings for `docker compose` at the repository root.
# Copy to .env (gitignored) only if you need to change something:  cp .env.example .env
#
# The server settings are different: see deploy/server.env.example.

# Dashboard port on your machine (the servers use 80)
DASHBOARD_PORT=8501

# Host port for the local PostgreSQL (5434 stays clear of a native install on 5432)
LOCAL_PG_PORT=5434

# Running the dashboard outside Docker (python -m streamlit run dashboard/app.py) against the
# local stack's database:
DASHBOARD_DATABASE_URL=postgresql://xom:xom@localhost:5434/xom
