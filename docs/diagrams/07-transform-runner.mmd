---
title: 07 · Transform runner + dbt
---
%% Mirrors the PNG/SVG of the same name. Render 16:9:
%%   npx -y @mermaid-js/mermaid-cli -i <file>.mmd -o <file>-mermaid.png -w 1920 -H 1080 -b white -s 2
flowchart LR
    BRONZE[("bronze<br/>raw_records")]
    TICK(["Every 30 s"]) --> CLOSE["Close interrupted runs<br/>'running' → 'failed'<br/>ops.pipeline_runs"]
    CLOSE --> WM["Read the watermark<br/>of the last successful run<br/>ops.pipeline_runs"]
    WM --> HIGH["Read bronze high mark<br/>max(ingested_at)"]
    BRONZE -.-> HIGH
    HIGH --> NEW{"Newer<br/>rows?"}
    NEW -- "no" --> WAIT["Wait for the next tick<br/>nothing recorded"]
    NEW -- "yes" --> RUN["Record a run<br/>status 'running'<br/>ops.pipeline_runs"]
    RUN --> DBT["dbt build<br/>silver and gold models<br/>+ 82 data tests · timeout 600 s"]
    DBT -- "builds" --> SILVER[("silver")]
    DBT -- "builds" --> GOLD[("gold")]
    DBT --> PASS{"All<br/>passed?"}
    PASS -- "yes" --> SUCCESS["Record 'success'<br/>new watermark = bronze high mark read before dbt<br/>rows_loaded = new rows"]
    PASS -- "no" --> FAILED["Record 'failed'<br/>no new watermark; dbt summary and failing tests<br/>retried on the next tick; gold left as it was"]

    classDef proc fill:#fff8eb,stroke:#d48806,color:#1f2937
    classDef store fill:#eaf2ff,stroke:#2f6fde,color:#1f2937
    classDef stream fill:#e7f7ee,stroke:#15965a,color:#1f2937
    classDef serve fill:#fdecef,stroke:#c23a57,color:#1f2937
    classDef bronze fill:#f7e8da,stroke:#b4692b,color:#1f2937
    classDef silver fill:#eef1f5,stroke:#7b8797,color:#1f2937
    classDef gold fill:#fbf1cc,stroke:#c29408,color:#1f2937
    classDef decision fill:#f3efff,stroke:#7c5cd6,color:#1f2937
    classDef ctx fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:6 4,color:#1f2937
    classDef ok fill:#eaf8f0,stroke:#15965a,color:#1f2937
    classDef fail fill:#fdeeee,stroke:#c2413b,color:#1f2937
    class TICK,WAIT ctx
    class CLOSE,WM,HIGH,RUN,DBT proc
    class NEW,PASS decision
    class BRONZE bronze
    class SILVER silver
    class GOLD gold
    class SUCCESS ok
    class FAILED fail
    linkStyle 12 stroke:#c2413b
