%% Mirrors the PNG/SVG of the same name. Render 16:9:
%%   npx -y @mermaid-js/mermaid-cli -i <file>.mmd -o <file>-mermaid.png -w 1920 -H 1080 -b white -s 2
flowchart LR
    KAFKA{{"Kafka<br/>raw.ecom_records"}} -- "poll" --> TAKE["Take a batch<br/>up to 1,000 messages<br/>or whatever arrived within 2 s"]
    TAKE --> CHECK["Check each message<br/>parse JSON, validate envelope"]
    CHECK --> WRITE["Write in one transaction<br/>valid rows, rejects and a run row"]
    WRITE --> OK{"Database<br/>commit OK?"}
    OK -- "yes" --> COMMIT["Commit Kafka offsets<br/>then the next batch"]
    COMMIT -- "next batch" --> TAKE
    OK -- "no" --> REWIND["Rewind to the batch start<br/>no offsets committed,<br/>back off up to 30 s"]
    REWIND -- "retry the same messages" --> TAKE
    WRITE -- "valid" --> RAW[("bronze.raw_records<br/>one row per record version<br/>ON CONFLICT DO NOTHING")]
    WRITE -- "invalid" --> REJ[("bronze.rejected_records<br/>invalid messages with the reason")]
    WRITE -- "summary" --> RUNS[("ops.pipeline_runs<br/>one 'ingest' row per batch")]

    classDef proc fill:#fff8eb,stroke:#d48806,color:#1f2937
    classDef store fill:#eaf2ff,stroke:#2f6fde,color:#1f2937
    classDef stream fill:#e7f7ee,stroke:#15965a,color:#1f2937
    classDef serve fill:#fdecef,stroke:#c23a57,color:#1f2937
    classDef bronze fill:#f7e8da,stroke:#b4692b,color:#1f2937
    classDef silver fill:#eef1f5,stroke:#7b8797,color:#1f2937
    classDef gold fill:#fbf1cc,stroke:#c29408,color:#1f2937
    classDef decision fill:#f3efff,stroke:#7c5cd6,color:#1f2937
    classDef ctx fill:#f8fafc,stroke:#94a3b8,stroke-dasharray:6 4,color:#1f2937
    classDef ok fill:#eaf8f0,stroke:#15965a,color:#1f2937
    classDef fail fill:#fdeeee,stroke:#c2413b,color:#1f2937
    class KAFKA stream
    class TAKE,CHECK,WRITE,COMMIT proc
    class OK decision
    class REWIND fail
    class RAW,REJ bronze
    class RUNS store
    linkStyle 6,7 stroke:#c2413b
