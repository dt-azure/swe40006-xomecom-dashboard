# --- Secrets: never commit these -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.streamlit/secrets.toml

# --- Data: the dataset is downloaded by a script, not committed ------------
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.csv
*.zip

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- Editors and OS ---------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
